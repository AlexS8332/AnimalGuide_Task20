# Скопируй в .env.local (или .env) и впиши свой ключ DeepSeek:
# https://platform.deepseek.com — .env и .env.local в git не попадают.
# Файлы ищутся в рабочем каталоге и выше по дереву; переменная окружения
# важнее файла.

DEEPSEEK_API_KEY=

# Необязательно — значения по умолчанию.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Источники для инструментов; ключей не требуют.
# WIKIPEDIA_BASE_URL=https://ru.wikipedia.org
# GBIF_BASE_URL=https://api.gbif.org/v1

# «Интересные факты» (v18). Демон animals-mcp берёт DEEPSEEK_API_KEY только
# из окружения. MCP_TOKEN — общий токен демона и его клиентов (приложения,
# mcp-list); без него демон слушает только 127.0.0.1.
# MCP_TOKEN=
# TRIVIA_SERVER=http://127.0.0.1:8766
# MDD_URL=https://raw.githubusercontent.com/mammaldiversity/mammaldiversity.github.io/refs/heads/master/assets/data/MDD.zip
